# ==============================================================================
# Monitoring Backend — Environment Configuration Template
# ==============================================================================
# CATATAN KEAMANAN:
# File ini di-commit ke Git sebagai CONTOH (Template).
# JANGAN PERNAH menaruh IP publik, password, atau API key asli di sini!
# Copy file ini menjadi '.env' di mesin lokal Anda lalu sesuaikan nilainya.
# ==============================================================================

# ===== Monitoring Backend Server =====
PORT=5000
NODE_ENV=development

# ===== Polling & Metrics Retention =====
POLL_INTERVAL_SECONDS=5
METRICS_RETENTION_MINUTES=60
METRICS_PATH=/metrics

# ===== Alerting Thresholds =====
ALERT_CPU_PERCENT=80
ALERT_MEMORY_PERCENT=85
ALERT_ERROR_RATE_PERCENT=5
ALERT_LATENCY_P99_MS=1000

# ==============================================================================
# Service Target URLs (OPSIONAL / FALLBACK)
# ==============================================================================
# Pada arsitektur multi-node, server dan service didaftarkan secara DINAMIS
# melalui UI Dashboard. Variabel di bawah ini hanya sebagai fallback jika
# dijalankan standalone.
#
# Gunakan IP host target Anda (misal: 192.168.1.10 atau domain server):

# Server 1 (Host 1):
SERVICE_IDENTITY_NAME=Identity Service
SERVICE_IDENTITY_URL=http://<SERVER_1_IP>:8080

SERVICE_LIFESTYLE_NAME=Lifestyle Service
SERVICE_LIFESTYLE_URL=http://<SERVER_1_IP>:4005

SERVICE_HEALTH_PROFILE_NAME=Health Profile Service
SERVICE_HEALTH_PROFILE_URL=http://<SERVER_1_IP>:3001

SERVICE_LIVE_CONSULT_NAME=Live Consult Service
SERVICE_LIVE_CONSULT_URL=http://<SERVER_1_IP>:4004

SERVICE_AUDIT_NAME=Audit Service
SERVICE_AUDIT_URL=http://<SERVER_1_IP>:4005

# Server 2 (Host 2):
SERVICE_AI_CONSULTATION_NAME=AI Consultation Service (Server 2)
SERVICE_AI_CONSULTATION_URL=http://<SERVER_2_IP>:4006
STRESS_TEST_AI_CONSULT_URL=http://<SERVER_2_IP>:4006

SERVICE_MEDICAL_RECORD_NAME=Medical Record Service
SERVICE_MEDICAL_RECORD_URL=http://<SERVER_2_IP>:3002

# Node Exporter Host Telemetry
SERVICE_NODE_EXPORTER_NAME=Node Exporter
SERVICE_NODE_EXPORTER_URL=http://localhost:9100

# ==============================================================================
# Google Gemini AI Insights (Stress Test & Performance Analysis)
# ==============================================================================
# Dapatkan API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# Online PostgreSQL (NeonDB - Stress Test History & Project Analytics)
# ==============================================================================
DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>.neon.tech/neondb?sslmode=require

