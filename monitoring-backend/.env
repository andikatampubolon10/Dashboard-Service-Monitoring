# =============================================
# Monitoring Backend — Environment Config
# =============================================

# ===== Monitoring Backend =====
PORT=5000
NODE_ENV=development

# ===== Service Registry =====
SERVICE_AI_CONSULTATION_NAME=AI Consultation Service
SERVICE_AI_CONSULTATION_URL=http://localhost:4006

SERVICE_AUDIT_NAME=Audit Service
SERVICE_AUDIT_URL=http://localhost:4005

SERVICE_HEALTH_PROFILE_NAME=Health Profile Service
SERVICE_HEALTH_PROFILE_URL=http://localhost:3001

SERVICE_IDENTITY_NAME=Identity Service
SERVICE_IDENTITY_URL=http://localhost:8081

SERVICE_LIFESTYLE_NAME=Lifestyle Service
SERVICE_LIFESTYLE_URL=http://localhost:4007

SERVICE_LIVE_CONSULT_NAME=Live Consult Service
SERVICE_LIVE_CONSULT_URL=http://localhost:4004

SERVICE_MEDICAL_RECORD_NAME=Medical Record Service
SERVICE_MEDICAL_RECORD_URL=http://localhost:3002

SERVICE_NODE_EXPORTER_NAME=Node Exporter
SERVICE_NODE_EXPORTER_URL=http://localhost:9100

# Semua service pakai /metrics (Prometheus format)
METRICS_PATH=/metrics

# ===== Polling & Retention =====
POLL_INTERVAL_SECONDS=5
METRICS_RETENTION_MINUTES=60

# ===== Alerting Thresholds =====
ALERT_CPU_PERCENT=80
ALERT_MEMORY_PERCENT=85
ALERT_ERROR_RATE_PERCENT=5
ALERT_LATENCY_P99_MS=1000
