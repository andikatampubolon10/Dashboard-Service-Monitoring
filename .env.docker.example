# ==============================================================================
# Dashboard Service Monitoring — Docker Environment Configuration Example
# ==============================================================================

# Port configuration
PORT=5000
NODE_ENV=production

# Remote Host default (fallback)
REMOTE_HOST=34.101.207.115

# Microservices scrape targets
SERVICE_AI_CONSULTATION_URL=http://34.101.122.171:4006
SERVICE_AUDIT_URL=http://34.101.207.115:4005
SERVICE_HEALTH_PROFILE_URL=http://34.101.207.115:3001
SERVICE_IDENTITY_URL=http://34.101.207.115:8080
SERVICE_LIFESTYLE_URL=http://34.101.207.115:4005
SERVICE_LIVE_CONSULT_URL=http://34.101.207.115:4004
SERVICE_MEDICAL_RECORD_URL=http://34.101.122.171:3002
SERVICE_NODE_EXPORTER_URL=http://localhost:9100

# Polling & Retention
POLL_INTERVAL_SECONDS=5
METRICS_RETENTION_MINUTES=60

# Alerting Thresholds
ALERT_CPU_PERCENT=80
ALERT_MEMORY_PERCENT=85
ALERT_ERROR_RATE_PERCENT=5
ALERT_LATENCY_P99_MS=1000
